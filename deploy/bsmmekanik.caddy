# BSM Mekanik — Caddy site ayarı
# Ana Caddyfile'a (genelde /etc/caddy/Caddyfile) şu satırı ekleyin:
#   import /opt/bsmmekanik/deploy/bsmmekanik.caddy
# Site dosyaları: /opt/bsmmekanik/public (depo /opt/bsmmekanik'e klonlanır)
# SSL sertifikalarını Caddy kendisi alır.

(bsm_site) {
	root * /opt/bsmmekanik/public
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}
	header /assets/css/* Cache-Control "public, max-age=31536000, immutable"
	header /assets/js/* Cache-Control "public, max-age=31536000, immutable"
	header /assets/fonts/* Cache-Control "public, max-age=31536000, immutable"
	header /assets/img/* Cache-Control "public, max-age=86400"
	header /assets/video/* Cache-Control "public, max-age=86400"

	route {
		# Teklif formu → sunucudaki form alıcı (deploy/form-server/server.js)
		reverse_proxy /api/teklif* 127.0.0.1:8787

		# Eski / alternatif adresler
		redir /en/references /en/projects permanent
		redir /en /en/ permanent

		@index path_regexp idx ^(.*/)index\.html$
		redir @index {re.idx.1} permanent

		@html {
			path_regexp html ^/(.+)\.html$
			not path /404.html
		}
		redir @html /{re.html.1} permanent

		# Yalnızca hata yanıtı olarak sunulan / Cloudflare'a özel dosyalar
		@hidden path /404.html /_headers /_redirects
		error @hidden 404

		# Temiz adresler: /kurumsal → kurumsal.html, /en/ → en/index.html
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
	}
}

# Demo adresi (arama motorlarına kapalı)
bsmmekanik.nesakyazilim.com {
	import bsm_site
	header X-Robots-Tag noindex
}

# Asıl adresler — GoDaddy'de A kayıtları bu sunucuyu gösterdiğinde etkinleştirin
